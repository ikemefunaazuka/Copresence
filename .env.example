# Copresence server configuration
#
# Every variable here is validated at boot by apps/server/src/config/env.ts.
# A missing or malformed value fails the boot with a non-zero exit rather
# than starting the server with wrong behaviour silently. Copy this file to
# .env and adjust as needed; .env itself is gitignored.

# development | test | production
NODE_ENV=development

# HTTP + WebSocket port — one port serves both.
PORT=3000

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Allowed origin for the demo page / API. "*" is fine for local development;
# set it explicitly before any real deployment.
CORS_ORIGIN=*

# Milliseconds of silence before the heartbeat reaper drops a participant
# and the server writes an inferred session.end.
PARTICIPANT_TTL_MS=15000

# Server broadcast tick rate. Outbound bandwidth is a function of this
# number and the participant count, not of how fast anyone moves their
# mouse — see docs/adr/0003.
TICK_RATE_HZ=20

# Optional. Only read if the optional durable-event-log support is built.
# Unset for v1 — presence and audit data do not need a database.
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/copresence
