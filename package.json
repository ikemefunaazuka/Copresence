{
  "name": "copresence",
  "version": "0.1.0",
  "private": true,
  "description": "A toy co-browsing core: two browsers sharing cursor position and scroll state over WebSockets, built to survive duplicate, late, out-of-order and missing messages.",
  "license": "MIT",
  "author": "Precious Ikemefuna Azuka",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "build": "npm run build --workspaces --if-present",
    "size": "size-limit",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run size"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@size-limit/file": "^12.1.0",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "prettier": "^3.9.8",
    "size-limit": "^12.1.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.1"
  }
}
